# ─── Tamurt Sending : variables d'environnement ───
# Copier en .env et compléter. Ne jamais committer de secret.

# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tamurt?schema=public"

# URL publique de l'application (sans / final)
APP_URL="http://localhost:3000"

# Authentification (Better Auth). Générer : openssl rand -base64 48
BETTER_AUTH_SECRET="à-remplacer-par-une-valeur-aléatoire-de-32-caractères-minimum"
BETTER_AUTH_URL="http://localhost:3000"
# Exiger la 2FA pour l'administration (true par défaut ; false uniquement en développement local)
ADMIN_REQUIRE_2FA="true"

# Sel secret des codes OTP (openssl rand -base64 32). Le changer invalide les codes en cours.
OTP_PEPPER="à-remplacer"
# Secret des routes /api/cron/* (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="à-remplacer"

# Connexion Google (facultatif)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Emails : outbox (dev, aucun envoi réel, visible sur /dev/mailbox) | resend
EMAIL_PROVIDER="outbox"
RESEND_API_KEY=""
EMAIL_FROM="Tamurt Sending <no-reply@votre-domaine.fr>"
CONTACT_EMAIL="contact@votre-domaine.fr"

# SMS : none | twilio
SMS_PROVIDER="none"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Paiements : local_sandbox (simulateur, interdit en production) | stripe
PAYMENT_PROVIDER="local_sandbox"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Vérification d'identité : local_sandbox (simulateur, interdit en production) | stripe_identity
KYC_PROVIDER="local_sandbox"
STRIPE_IDENTITY_WEBHOOK_SECRET=""

# Stockage des fichiers : local (dev) | s3 (S3, R2, Scaleway, OVH…)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Origine publique des URLs signées S3 (ajoutée à la CSP img-src), ex. https://bucket.s3.eu-west-3.amazonaws.com
S3_PUBLIC_ORIGIN=""

# Monitoring (facultatif)
SENTRY_DSN=""

# Données de démonstration au seed (jamais en production)
SEED_DEMO="false"
